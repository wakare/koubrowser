{
  "name": "koubrowser",
  "version": "1.0.5",
  "description": "甲ブラウザ",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "gen:types": "npx orval",
    "gen:licenses": "node scripts/generate-bundled-licenses.js",
    "data:bundle": "node scripts/create-data-update-bundle.js",
    "data:bundle:verify": "node scripts/verify-data-update-bundle.js",
    "data:key:generate": "node scripts/generate-data-update-key.js",
    "data:key:inspect": "node scripts/inspect-data-update-public-key.js",
    "data:key:rotation:verify": "node scripts/verify-data-update-key-rotation.js",
    "data:quest:export": "vite-node --config vitest.config.ts scripts/export-reviewed-quest-knowledge.ts",
    "data:quest-strategy:contract:verify": "node scripts/validate-quest-strategy-authoring.js",
    "data:quest-strategy:pilot:verify": "node scripts/validate-quest-strategy-authoring.js --manifest knowledge/quest-strategy/pilot-authoring-manifest.json",
    "data:quest-strategy:inventory": "vite-node --config vitest.config.ts scripts/quest-strategy-inventory.ts",
    "data:quest-strategy:inventory:verify": "vite-node --config vitest.config.ts scripts/quest-strategy-inventory.ts --check",
    "data:quest-strategy:cadence": "vite-node --config vitest.config.ts scripts/import-quest-strategy-cadence.ts",
    "data:quest-strategy:cadence:verify": "vite-node --config vitest.config.ts scripts/import-quest-strategy-cadence.ts --check",
    "data:quest-strategy:compile": "vite-node --config vitest.config.ts scripts/compile-quest-strategy-v2.ts",
    "data:quest-strategy:compile:verify": "vite-node --config vitest.config.ts scripts/compile-quest-strategy-v2.ts --check",
    "data:quest-growth:compile": "node scripts/compile-quest-growth.js",
    "data:quest-growth:verify": "node scripts/compile-quest-growth.js --check",
    "data:release:record": "node scripts/create-data-update-release-record.js",
    "data:release:verify": "node scripts/verify-data-update-release-record.js",
    "copy-dev-code": "node scripts/copy-dev-code.js",
    "check:l10n": "node scripts/check-localization-raw-strings.js",
    "prepare:generated": "npm run gen:licenses && npm run copy-dev-code",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "npm run typecheck:web:main && npm run typecheck:web:option",
    "typecheck:web:main": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:web:option": "vue-tsc --noEmit -p tsconfig.option.json --composite false",
    "typecheck:parallel": "node scripts/run-npm-scripts-parallel.js typecheck:node typecheck:web:main typecheck:web:option",
    "typecheck": "npm run prepare:generated && npm run typecheck:parallel",
    "start": "electron-vite preview",
    "dev": "npm run gen:licenses && npm run copy-dev-code && electron-vite dev",
    "build:bundle": "npm run prepare:generated && electron-vite build",
    "build:bundle:silent": "npm run prepare:generated && electron-vite build --logLevel warn",
    "build": "npm run typecheck && electron-vite build",
    "build-silent": "npm run typecheck && electron-vite build --logLevel warn",
    "verify:quick": "npm run prepare:generated && npm run verify:checks",
    "verify": "npm run prepare:generated && npm run verify:checks && electron-vite build --logLevel warn",
    "verify:layout": "npm run verify && npm run smoke:layout",
    "smoke:electron": "node scripts/electron-smoke.js",
    "smoke:layout": "node scripts/electron-smoke.js --layout-fixture --workspace-pages --wide-workspace --summary",
    "smoke:localization": "node scripts/electron-smoke.js --layout-fixture --pseudo-locale --workspace-pages --summary",
    "smoke:data-update": "node scripts/electron-smoke.js --layout-fixture --data-update-fixture --task-guide --summary",
    "smoke:accept:data-update": "node scripts/electron-smoke.js --layout-fixture --task-guide --summary",
    "smoke:account-restore": "node scripts/electron-smoke.js --layout-fixture --account-restore-fixture --account-restore-records 10000 --summary",
    "smoke:layout:capture": "node scripts/electron-smoke.js --layout-fixture --workspace-pages --wide-workspace --summary --screenshot-dir output/layout-smoke",
    "smoke:accept:issue-23": "node scripts/electron-smoke.js --layout-fixture --workspace-pages --wide-workspace --summary --require-display-profile issue-23 --screenshot-dir output/acceptance-issue-23",
    "smoke:accept:issue-30": "node scripts/electron-smoke.js --manual-game-start --workspace-pages --summary --require-live-profile issue-30 --timeout 300000 --total-timeout 900000 --screenshot-dir output/acceptance-issue-30",
    "smoke:accept:issue-34": "node scripts/electron-smoke.js --layout-fixture --workspace-pages --wide-workspace --summary --require-display-profile issue-34 --screenshot-dir output/acceptance-issue-34",
    "smoke:live": "node scripts/electron-smoke.js --manual-game-start --workspace-pages --task-guide --wide-workspace --summary --timeout 300000 --total-timeout 900000 --screenshot-dir output/layout-smoke-live",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "test:verify": "vitest run --silent=passed-only",
    "verify:checks": "node scripts/run-npm-scripts-parallel.js typecheck:parallel test:verify",
    "test:hr": "vitest",
    "@test:u command comment": "Update snapshots. Run this if a snapshot test fails and the changes are expected.",
    "test:u": "vitest --update",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "buefy": "3.0.2",
    "electron-updater": "^6.3.9",
    "highcharts": "9.3.3",
    "moment": "^2.30.1",
    "nedb": "^1.8.0",
    "qs": "^6.14.0",
    "uuid": "^12.0.0",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/http-proxy": "^1.17.16",
    "@types/nedb": "^1.8.16",
    "@types/node": "^22.16.5",
    "@types/qs": "^6.14.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "electron-vite": "^4.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.3.0",
    "happy-dom": "^20.0.0",
    "orval": "^8.2.0",
    "prettier": "^3.6.2",
    "sass-embedded": "1.93.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vite-node": "3.2.4",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^3.2.4",
    "vue": "3.5.17",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.3"
  }
}
