      "id": "growth:safety-executable",
      "revision": 1,
      "status": "draft",
      "phase": "safety",
      "goal": "安全に実行できる状態を先に作る",
      "rationale": "補給不足、損傷、入渠、素材誤使用を無視した推薦は、成長より先に損失を増やす。",
      "decisionKind": "mixed",
      "requiredObservables": [
        "fleet.damage-summary",
        "fleet.supply-summary",
        "dock.repair-summary",
        "modernization.material-summary"
      ],
      "prerequisites": [],
      "triggers": [
        {
          "observable": "fleet.safety-state",
          "condition": "状態が不明、または既存の警告がある",
          "unknownPolicy": "fallback"
        }
      ],
      "guidance": {
        "now": "既存の補給・損傷・入渠警告を確認し、重要艦や重要装備を素材にしない。",
        "next": "安全状態が確認できたら、経験または資源ループへ進む。",
        "longTerm": "どの成長推薦でも出撃前の安全条件を共通 gate として再利用する。",
        "fallback": "状態を確認できないため具体的な出撃先は示さず、補給、損傷、入渠、素材艦を手動確認する。"
      },
      "expectedBenefits": [
        "無意味な出撃失敗と修理負担を避ける。",
        "不完全な観測から安全を断定しない。"
      ],
      "costs": ["状態確認が終わるまで出撃推薦を保留する。"],
      "risks": ["現在のアプリが必要な安全状態をすべて観測できるとは未確認である。"],
      "stopConditions": [
