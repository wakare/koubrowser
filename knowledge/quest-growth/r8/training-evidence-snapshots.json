      "supportedClaims": [
        "claim:exercise-low-repair-training",
        "claim:modernization-before-after-remodel"
      ],
      "facts": [
        {
          "factId": "fact:practice-no-persistent-damage",
          "statement": "演習中の損傷は母港へ持ち越されず、経験値を得られる。"
        },
        {
          "factId": "fact:practice-opponent-dependent",
          "statement": "演習経験値と勝敗は相手の旗艦・二番艦の練度や双方の編成に左右される。"
        },
        {
          "factId": "fact:remodel-keeps-level",
          "statement": "改造後も艦娘の練度と経験値は引き継がれる。"
        },
        {
          "factId": "fact:normal-modernization-reset",
          "statement": "通常の火力・雷装・対空・装甲の近代化改修上昇分は改造時にリセットされる。"
        },
        {
          "factId": "fact:pre-remodel-strengthening-is-conditional",
          "statement": "改造前の近代化改修は常に禁止ではなく、現在の攻略を支える小規模強化として条件付きで扱われる。"
        },
        {
          "factId": "fact:material-consumption-needs-confirmation",
          "statement": "近代化改修素材にした艦娘は失われるため、対象を一隻ずつ確認する必要がある。"
        }
      ],
      "notes": [
        "演習回数は画面で確認し、端末の累計値から残数を推定しない。",
        "運・耐久・対潜の特殊な近代化改修は通常四項目と分ける。"
      ]
    },
    {
      "sourceId": "source:kcwiki-leveling-r8-training",
      "independenceGroupId": "group:kcwiki-zh",
      "url": "https://zh.kcwiki.cn/wiki/攻略:练级指南",
      "title": "攻略:练级指南",
      "site": "舰娘百科",
