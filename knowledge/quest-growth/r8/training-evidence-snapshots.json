      "checkedAt": "2026-08-03T02:00:00.000Z",
      "reviewBy": "2026-10-30T00:00:00.000Z",
      "validUntil": "2027-01-28T00:00:00.000Z",
      "supportedClaims": ["claim:exercise-low-repair-training"],
      "facts": [
        {
          "factId": "fact:practice-all-ship-types",
          "statement": "演習は全艦種の育成候補として扱われる。"
        },
        {
          "factId": "fact:practice-no-repair-cost",
          "statement": "演習で受けた損傷は修理を必要とせず、修復材を消費しない。"
        },
        {
          "factId": "fact:practice-refresh-manual",
          "statement": "演習候補は更新枠ごとに変わるため、現在の画面で利用可能な相手を確認する。"
        },
        {
          "factId": "fact:no-single-best-leveling-route",
          "statement": "育成方法は艦種、資源、修復材、時間に合わせて選び、単一の最適解に固定しない。"
        }
      ],
      "notes": [
        "海域別育成候補はこのルートに含めず、既存の対潜・水上ルートと分離する。",
        "勝利や獲得経験値を現在の相手情報なしに保証しない。"
      ]
    },
    {
      "sourceId": "source:kcwiki-modernization-r8-training",
      "independenceGroupId": "group:kcwiki-zh",
      "url": "https://zh.kcwiki.cn/wiki/近代化改修",
      "title": "近代化改修",
      "site": "舰娘百科",
