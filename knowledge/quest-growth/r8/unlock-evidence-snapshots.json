      "supportedClaims": ["claim:expedition-resource-loop"],
      "facts": [
        {
          "factId": "fact:wikiwiki:a1-a4-second-fleet",
          "statement": "A1→A2→A3→A4の順で編成任務が開き、A4は6隻編成で第2艦隊を開放する。"
        },
        {
          "factId": "fact:wikiwiki:a5-a7-a14-third-fleet",
          "statement": "A5→A7→A14へ進み、A14で川内・神通・那珂を同一艦隊に編成すると第3艦隊を開放する。"
        },
        {
          "factId": "fact:wikiwiki:a15-a16-fourth-fleet",
          "statement": "A14後のA15で妙高・那智・足柄・羽黒を編成し、続くA16で金剛・比叡・榛名・霧島を編成すると第4艦隊を開放する。"
        },
        {
          "factId": "fact:wikiwiki:formation-conditions",
          "statement": "A3は軽巡旗艦と駆逐2隻以上、A7は重巡2隻以上、A4は正確に6隻の編成を要求する。"
        }
      ],
      "notes": [
        "常設編成任務の表だけを根拠とし、未表示任務を端末観測から完了済みとは推定しない。",
        "艦娘の入手順や建造・ドロップ優先度はこの証拠から導出しない。"
      ]
    },
